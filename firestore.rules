rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validAvatarId(avatarId) {
      return avatarId in [
        'assalto', 'pesado', 'reconhecimento',
        'Nc_temperate_forest_light_assault', 'Nc_temperate_forest_heavy_assault',
        'Nc_temperate_forest_infiltrator', 'Nc_temperate_forest_engineer',
        'Nc_temperate_forest_combat_medic', 'Nc_temperate_forest_max',
        'Tr_temperate_forest_light_assault', 'Tr_temperate_forest_heavy_assault',
        'Tr_temperate_forest_infiltrator', 'Tr_temperate_forest_engineer',
        'Tr_temperate_forest_combat_medic', 'Tr_temperate_forest_max',
        'Vs_temperate_forest_light_assault', 'Vs_temperate_forest_heavy_assault',
        'Vs_temperate_forest_infiltrator', 'Vs_temperate_forest_engineer',
        'Vs_temperate_forest_combat_medic', 'Vs_temperate_forest_max',
        'NS_light_assault', 'NS_heavy_assault', 'NS_infiltrator',
        'NS_engineer', 'NS_combat_medic',
        'personalizado_assalto', 'personalizado_pesado', 'personalizado_reconhecimento'
      ];
    }

    function validBannerId(bannerId) {
      return bannerId in [
        'brasil', 'comando', 'noturna',
        'Bunner_01', 'Bunner_02', 'Bunner_03', 'Bunner_04', 'Bunner_05',
        'Bunner_06', 'Bunner_07', 'Bunner_08', 'Bunner_09', 'Bunner_010',
        'Bunner_011', 'Bunner_012', 'Bunner_013', 'Bunner_014', 'Bunner_015',
        'Bunner_016', 'Bunner_017', 'Bunner_018', 'Bunner_019', 'Bunner_020',
        'Bunner_021', 'Bunner_022'
      ];
    }

    function premiumAvatarIds(profileData) {
      return profileData.keys().hasAny(['premiumAvatarIds'])
        ? profileData.premiumAvatarIds
        : [];
    }

    function validNewMember(userId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'role', 'rankId', 'avatarId', 'bannerId',
          'bio', 'favoriteClass', 'favoriteFaction',
          'featuredMedalIds', 'premiumAvatarIds',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.rankId == 'soldado'
        && validAvatarId(request.resource.data.avatarId)
        && validBannerId(request.resource.data.bannerId)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 220
        && request.resource.data.favoriteClass in ['', 'infiltrador', 'assalto-leve', 'medico', 'engenheiro', 'assalto-pesado', 'max']
        && request.resource.data.favoriteFaction in ['', 'tr', 'nc', 'vs', 'nso']
        && request.resource.data.featuredMedalIds is list
        && request.resource.data.featuredMedalIds.size() <= 5
        && request.resource.data.premiumAvatarIds is list
        && request.resource.data.premiumAvatarIds.size() == 0;
    }

    function validMemberProfileUpdate(userId) {
      return owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarId', 'bannerId', 'bio', 'favoriteClass', 'favoriteFaction', 'featuredMedalIds', 'premiumAvatarIds', 'updatedAt'])
        && (validAvatarId(request.resource.data.avatarId)
          || request.resource.data.avatarId in premiumAvatarIds(resource.data))
        && request.resource.data.premiumAvatarIds is list
        && request.resource.data.premiumAvatarIds == premiumAvatarIds(resource.data)
        && validBannerId(request.resource.data.bannerId)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 220
        && request.resource.data.favoriteClass in ['', 'infiltrador', 'assalto-leve', 'medico', 'engenheiro', 'assalto-pesado', 'max']
        && request.resource.data.favoriteFaction in ['', 'tr', 'nc', 'vs', 'nso']
        && request.resource.data.featuredMedalIds is list
        && request.resource.data.featuredMedalIds.size() <= 5;
    }

    function validParticipation(userId, operationId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'operationId', 'title', 'startsAt', 'status', 'userId',
          'displayName', 'joinedAt'
        ])
        && request.resource.data.operationId == operationId
        && request.resource.data.userId == userId
        && request.resource.data.status == 'confirmed';
    }

    function validPublicProfileCreate(userId) {
      return owns(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'rankId', 'avatarId', 'bannerId',
          'bio', 'favoriteClass', 'favoriteFaction',
          'featuredMedals', 'recentActivities', 'premiumAvatarIds', 'updatedAt'
        ])
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.rankId == get(/databases/$(database)/documents/users/$(userId)).data.rankId
        && request.resource.data.avatarId == get(/databases/$(database)/documents/users/$(userId)).data.avatarId
        && request.resource.data.bannerId == get(/databases/$(database)/documents/users/$(userId)).data.bannerId
        && request.resource.data.bio == get(/databases/$(database)/documents/users/$(userId)).data.bio
        && request.resource.data.favoriteClass == get(/databases/$(database)/documents/users/$(userId)).data.favoriteClass
        && request.resource.data.favoriteFaction == get(/databases/$(database)/documents/users/$(userId)).data.favoriteFaction
        && request.resource.data.premiumAvatarIds == premiumAvatarIds(get(/databases/$(database)/documents/users/$(userId)).data)
        && request.resource.data.featuredMedals is list
        && request.resource.data.featuredMedals.size() <= 5
        && request.resource.data.recentActivities is list
        && request.resource.data.recentActivities.size() <= 3;
    }

    function validPublicProfileUpdate(userId) {
      return owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'bannerId', 'bio', 'favoriteClass', 'favoriteFaction', 'featuredMedals',
          'recentActivities', 'premiumAvatarIds', 'updatedAt'
        ])
        && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.rankId == get(/databases/$(database)/documents/users/$(userId)).data.rankId
        && request.resource.data.avatarId == get(/databases/$(database)/documents/users/$(userId)).data.avatarId
        && request.resource.data.bannerId == get(/databases/$(database)/documents/users/$(userId)).data.bannerId
        && request.resource.data.bio == get(/databases/$(database)/documents/users/$(userId)).data.bio
        && request.resource.data.favoriteClass == get(/databases/$(database)/documents/users/$(userId)).data.favoriteClass
        && request.resource.data.favoriteFaction == get(/databases/$(database)/documents/users/$(userId)).data.favoriteFaction
        && request.resource.data.premiumAvatarIds == premiumAvatarIds(get(/databases/$(database)/documents/users/$(userId)).data)
        && request.resource.data.featuredMedals is list
        && request.resource.data.featuredMedals.size() <= 5
        && request.resource.data.recentActivities is list
        && request.resource.data.recentActivities.size() <= 3;
    }

    function validGalleryCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'url', 'title', 'description', 'createdBy', 'authorName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://.*')
        && request.resource.data.url.size() <= 500
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 220
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 80;
    }

    match /users/{userId} {
      allow create: if validNewMember(userId);
      allow read: if owns(userId) || isAdmin();
      allow update: if isAdmin() || validMemberProfileUpdate(userId);
      allow delete: if isAdmin();

      match /medals/{medalId} {
        allow read: if owns(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /participations/{operationId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if validParticipation(userId, operationId);
        allow update, delete: if isAdmin();
      }
    }

    match /operations/{operationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /participants/{userId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if validParticipation(userId, operationId);
        allow update, delete: if isAdmin();
      }
    }

    match /medalCatalog/{medalId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /premiumAvatarCatalog/{avatarId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin() || validPublicProfileCreate(userId);
      allow update: if isAdmin() || validPublicProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    match /communityGallery/{itemId} {
      allow read: if signedIn();
      allow create: if validGalleryCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
